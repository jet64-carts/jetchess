(
    app_name: "JetChess",
    publisher: "@73v3",
    description: "A chess machine for Jet64: a real engine, ninety named openings, and pieces you pick up off the board.",
    version: "1.0.0",
    copyright: "© 2026 73v3 - 73v3.com",
    publish_enabled: true,
    web_splash: (
        start_label: "Click to play",
        instructions: "Drag a piece, or click it and click its square. Click to begin.",
        theme: (
            background: "#0b0e14",
            text: "#e6edf3",
            hint: "#8b98a5",
            accent: "#4fd6be",
            accent_text: "#04211c",
            font_family: "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        ),
        wallpaper: (
            fit: Tile,
            scale: 1,
            crisp: true,
        ),
    ),
)