// carts/jetchess/data/gfx/imports.ron
//
// The bake recipe for JetChess's twelve pieces — generated by
// scripts/jetchess_art.py alongside the pictures it names. Do not edit:
// edit the script and run it.
//
// Each piece is baked with an `edge`: its anti-aliased rim is resolved
// against one palette entry and a ring of that entry is grown around it
// (src/core/coverage.rs). A white piece is ringed in ink and a black piece
// in bone, so one bake of each reads on a light square, on a dark square,
// and in mid-air under the pointer.
//
// The two `background` indexes below are JC_INK and JC_BONE of
// carts/jetchess/art/palette.h — a recipe holds palette entries, and an
// entry is a number.
//
// `quantize` confines the bake to the art's own entries, so the type's
// ramps that stand after them never take a piece's pixel.
#![enable(implicit_some)]
(
    root: "carts/jetchess/data/art",
    cell: 64,
    quantize: (lo: 1, hi: 121),
    imports: [
        (dest:  0, name: "white pawn on any square", layers: ["white_pawn.png"], edge: (background: 14, outline_px: 2)), // JC_INK
        (dest: 16, name: "black pawn on a dark square", layers: ["black_pawn_on_dark.png"], edge: (background: 15, outline_px: 2)), // JC_BONE
        (dest: 32, name: "black pawn on a light square", layers: ["black_pawn_on_light.png"], edge: (background: 16, outline_px: 2)), // JC_BONE_QUIET
        (dest: 48, name: "white pawn on a quiet board", layers: ["white_pawn_hushed.png"], edge: (background: 46, outline_px: 2)), // JC_INK_HUSHED
        (dest: 64, name: "black pawn on a quiet dark square", layers: ["black_pawn_hushed_on_dark.png"], edge: (background: 48, outline_px: 2)), // JC_BONE_HUSHED
        (dest: 80, name: "black pawn on a quiet light square", layers: ["black_pawn_hushed_on_light.png"], edge: (background: 49, outline_px: 2)), // JC_BONE_QUIET_HUSHED
        (dest:  1, name: "white knight on any square", layers: ["white_knight.png"], edge: (background: 14, outline_px: 2)), // JC_INK
        (dest: 17, name: "black knight on a dark square", layers: ["black_knight_on_dark.png"], edge: (background: 15, outline_px: 2)), // JC_BONE
        (dest: 33, name: "black knight on a light square", layers: ["black_knight_on_light.png"], edge: (background: 16, outline_px: 2)), // JC_BONE_QUIET
        (dest: 49, name: "white knight on a quiet board", layers: ["white_knight_hushed.png"], edge: (background: 46, outline_px: 2)), // JC_INK_HUSHED
        (dest: 65, name: "black knight on a quiet dark square", layers: ["black_knight_hushed_on_dark.png"], edge: (background: 48, outline_px: 2)), // JC_BONE_HUSHED
        (dest: 81, name: "black knight on a quiet light square", layers: ["black_knight_hushed_on_light.png"], edge: (background: 49, outline_px: 2)), // JC_BONE_QUIET_HUSHED
        (dest:  2, name: "white bishop on any square", layers: ["white_bishop.png"], edge: (background: 14, outline_px: 2)), // JC_INK
        (dest: 18, name: "black bishop on a dark square", layers: ["black_bishop_on_dark.png"], edge: (background: 15, outline_px: 2)), // JC_BONE
        (dest: 34, name: "black bishop on a light square", layers: ["black_bishop_on_light.png"], edge: (background: 16, outline_px: 2)), // JC_BONE_QUIET
        (dest: 50, name: "white bishop on a quiet board", layers: ["white_bishop_hushed.png"], edge: (background: 46, outline_px: 2)), // JC_INK_HUSHED
        (dest: 66, name: "black bishop on a quiet dark square", layers: ["black_bishop_hushed_on_dark.png"], edge: (background: 48, outline_px: 2)), // JC_BONE_HUSHED
        (dest: 82, name: "black bishop on a quiet light square", layers: ["black_bishop_hushed_on_light.png"], edge: (background: 49, outline_px: 2)), // JC_BONE_QUIET_HUSHED
        (dest:  3, name: "white rook on any square", layers: ["white_rook.png"], edge: (background: 14, outline_px: 2)), // JC_INK
        (dest: 19, name: "black rook on a dark square", layers: ["black_rook_on_dark.png"], edge: (background: 15, outline_px: 2)), // JC_BONE
        (dest: 35, name: "black rook on a light square", layers: ["black_rook_on_light.png"], edge: (background: 16, outline_px: 2)), // JC_BONE_QUIET
        (dest: 51, name: "white rook on a quiet board", layers: ["white_rook_hushed.png"], edge: (background: 46, outline_px: 2)), // JC_INK_HUSHED
        (dest: 67, name: "black rook on a quiet dark square", layers: ["black_rook_hushed_on_dark.png"], edge: (background: 48, outline_px: 2)), // JC_BONE_HUSHED
        (dest: 83, name: "black rook on a quiet light square", layers: ["black_rook_hushed_on_light.png"], edge: (background: 49, outline_px: 2)), // JC_BONE_QUIET_HUSHED
        (dest:  4, name: "white queen on any square", layers: ["white_queen.png"], edge: (background: 14, outline_px: 2)), // JC_INK
        (dest: 20, name: "black queen on a dark square", layers: ["black_queen_on_dark.png"], edge: (background: 15, outline_px: 2)), // JC_BONE
        (dest: 36, name: "black queen on a light square", layers: ["black_queen_on_light.png"], edge: (background: 16, outline_px: 2)), // JC_BONE_QUIET
        (dest: 52, name: "white queen on a quiet board", layers: ["white_queen_hushed.png"], edge: (background: 46, outline_px: 2)), // JC_INK_HUSHED
        (dest: 68, name: "black queen on a quiet dark square", layers: ["black_queen_hushed_on_dark.png"], edge: (background: 48, outline_px: 2)), // JC_BONE_HUSHED
        (dest: 84, name: "black queen on a quiet light square", layers: ["black_queen_hushed_on_light.png"], edge: (background: 49, outline_px: 2)), // JC_BONE_QUIET_HUSHED
        (dest:  5, name: "white king on any square", layers: ["white_king.png"], edge: (background: 14, outline_px: 2)), // JC_INK
        (dest: 21, name: "black king on a dark square", layers: ["black_king_on_dark.png"], edge: (background: 15, outline_px: 2)), // JC_BONE
        (dest: 37, name: "black king on a light square", layers: ["black_king_on_light.png"], edge: (background: 16, outline_px: 2)), // JC_BONE_QUIET
        (dest: 53, name: "white king on a quiet board", layers: ["white_king_hushed.png"], edge: (background: 46, outline_px: 2)), // JC_INK_HUSHED
        (dest: 69, name: "black king on a quiet dark square", layers: ["black_king_hushed_on_dark.png"], edge: (background: 48, outline_px: 2)), // JC_BONE_HUSHED
        (dest: 85, name: "black king on a quiet light square", layers: ["black_king_hushed_on_light.png"], edge: (background: 49, outline_px: 2)), // JC_BONE_QUIET_HUSHED
    ],
)
